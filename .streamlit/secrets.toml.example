# ─────────────────────────────────────────────────────────────────────────────
# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# This file is a TEMPLATE. Copy it to secrets.toml when running locally,
# or add these values as "Secrets" in the Streamlit Community Cloud dashboard.
#
# DO NOT commit the real secrets.toml to Git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API (free tier, no credit card needed for basic use) ─────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Cloud mode toggle ─────────────────────────────────────────────────────────
# Set to "true" when deploying to Streamlit Community Cloud (uses Groq instead of Ollama).
# Leave as "false" (or omit) when running locally with Ollama.
CLOUD_MODE = "true"

# ── Optional: override the Groq model (default is llama-3.1-8b-instant) ──────
# GROQ_MODEL = "llama-3.1-8b-instant"

